<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_scct_approval"
                  targetNamespace="http://scct.demo/approval">
  <bpmn:process id="approval_process_v1" name="SCCT 分级审批" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="提交审批">
      <bpmn:outgoing>F_Start_Task</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- 启动参数入口：SpiffArena 启动接口不读取创建请求体，变量经首个用户任务提交 -->
    <bpmn:userTask id="Task_Start" name="填写审批参数">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="start-task-schema.json"/>
          <spiffworkflow:property name="formUiSchemaFilename" value="start-task-uischema.json"/>
        </spiffworkflow:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_Start_Task</bpmn:incoming>
      <bpmn:outgoing>F_Start_Init</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F_Start_Task" sourceRef="StartEvent_1" targetRef="Task_Start"/>
    <bpmn:sequenceFlow id="F_Start_Init" sourceRef="Task_Start" targetRef="Task_Init"/>

    <!-- 初始化默认变量：手工启动未填参数时，网关表达式仍可求值 -->
    <bpmn:scriptTask id="Task_Init" name="初始化参数" scriptFormat="python">
      <bpmn:incoming>F_Start_Init</bpmn:incoming>
      <bpmn:outgoing>F_Init_Gw</bpmn:outgoing>
      <bpmn:script><![CDATA[
approved = False
]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:exclusiveGateway id="Gw_Level" name="按签署方式分流" default="F_Unsupported">
      <bpmn:incoming>F_Init_Gw</bpmn:incoming>
      <bpmn:outgoing>F_L1</bpmn:outgoing>
      <bpmn:outgoing>F_L2</bpmn:outgoing>
      <bpmn:outgoing>F_L3</bpmn:outgoing>
      <bpmn:outgoing>F_Unsupported</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="F_Init_Gw" sourceRef="Task_Init" targetRef="Gw_Level"/>

    <bpmn:sequenceFlow id="F_L1" sourceRef="Gw_Level" targetRef="Task_AutoApprove">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[sign_type == 'AUTO']]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_L2" sourceRef="Gw_Level" targetRef="Task_Sign_R3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[sign_type == 'DUAL']]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_L3" sourceRef="Gw_Level" targetRef="Task_Sign_R1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[sign_type == 'SINGLE']]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Unsupported" sourceRef="Gw_Level" targetRef="End_Rejected"/>

    <!-- L1：自动核准 -->
    <bpmn:scriptTask id="Task_AutoApprove" name="自动核准" scriptFormat="python">
      <bpmn:incoming>F_L1</bpmn:incoming>
      <bpmn:outgoing>F_Auto_End</bpmn:outgoing>
      <bpmn:script>approved = True</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="F_Auto_End" sourceRef="Task_AutoApprove" targetRef="End_Approved"/>

    <!-- L2：R3 主签 -> R5 会签（顺序双签） -->
    <bpmn:userTask id="Task_Sign_R3" name="R3 主签">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="approval-task-schema.json"/>
          <spiffworkflow:property name="formUiSchemaFilename" value="approval-task-uischema.json"/>
        </spiffworkflow:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_L2</bpmn:incoming>
      <bpmn:outgoing>F_R3_Gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F_R3_Gw" sourceRef="Task_Sign_R3" targetRef="Gw_R3"/>
    <bpmn:exclusiveGateway id="Gw_R3" name="R3 结果" default="F_R3_Rejected">
      <bpmn:incoming>F_R3_Gw</bpmn:incoming>
      <bpmn:outgoing>F_R3_Approved</bpmn:outgoing>
      <bpmn:outgoing>F_R3_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F_R3_Approved" sourceRef="Gw_R3" targetRef="Task_Sign_R5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[approved == True]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_R3_Rejected" sourceRef="Gw_R3" targetRef="End_Rejected"/>

    <bpmn:userTask id="Task_Sign_R5" name="R5 会签">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="approval-task-schema.json"/>
          <spiffworkflow:property name="formUiSchemaFilename" value="approval-task-uischema.json"/>
        </spiffworkflow:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_R3_Approved</bpmn:incoming>
      <bpmn:outgoing>F_R5_Gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F_R5_Gw" sourceRef="Task_Sign_R5" targetRef="Gw_R5"/>
    <bpmn:exclusiveGateway id="Gw_R5" name="R5 结果" default="F_R5_Rejected">
      <bpmn:incoming>F_R5_Gw</bpmn:incoming>
      <bpmn:outgoing>F_R5_Approved</bpmn:outgoing>
      <bpmn:outgoing>F_R5_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F_R5_Approved" sourceRef="Gw_R5" targetRef="Task_FinalizeApproved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[approved == True]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_R5_Rejected" sourceRef="Gw_R5" targetRef="End_Rejected"/>

    <!-- L3：R1 单签 -->
    <bpmn:userTask id="Task_Sign_R1" name="R1 审批">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="approval-task-schema.json"/>
          <spiffworkflow:property name="formUiSchemaFilename" value="approval-task-uischema.json"/>
        </spiffworkflow:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_L3</bpmn:incoming>
      <bpmn:outgoing>F_R1_Gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F_R1_Gw" sourceRef="Task_Sign_R1" targetRef="Gw_R1"/>
    <bpmn:exclusiveGateway id="Gw_R1" name="R1 结果" default="F_R1_Rejected">
      <bpmn:incoming>F_R1_Gw</bpmn:incoming>
      <bpmn:outgoing>F_R1_Approved</bpmn:outgoing>
      <bpmn:outgoing>F_R1_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F_R1_Approved" sourceRef="Gw_R1" targetRef="Task_FinalizeApproved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[approved == True]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_R1_Rejected" sourceRef="Gw_R1" targetRef="End_Rejected"/>

    <bpmn:scriptTask id="Task_FinalizeApproved" name="标记通过" scriptFormat="python">
      <bpmn:incoming>F_R5_Approved</bpmn:incoming>
      <bpmn:incoming>F_R1_Approved</bpmn:incoming>
      <bpmn:outgoing>F_Final_End</bpmn:outgoing>
      <bpmn:script>approved = True</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="F_Final_End" sourceRef="Task_FinalizeApproved" targetRef="End_Approved"/>

    <bpmn:endEvent id="End_Approved" name="已通过">
      <bpmn:incoming>F_Auto_End</bpmn:incoming>
      <bpmn:incoming>F_Final_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Rejected" name="已驳回">
      <bpmn:incoming>F_Unsupported</bpmn:incoming>
      <bpmn:incoming>F_R3_Rejected</bpmn:incoming>
      <bpmn:incoming>F_R5_Rejected</bpmn:incoming>
      <bpmn:incoming>F_R1_Rejected</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="approval_process_v1">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="80" y="240" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Start_di" bpmnElement="Task_Start">
        <dc:Bounds x="150" y="218" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Init_di" bpmnElement="Task_Init">
        <dc:Bounds x="300" y="218" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Level_di" bpmnElement="Gw_Level" isMarkerVisible="true">
        <dc:Bounds x="440" y="233" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AutoApprove_di" bpmnElement="Task_AutoApprove">
        <dc:Bounds x="550" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Sign_R3_di" bpmnElement="Task_Sign_R3">
        <dc:Bounds x="550" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_R3_di" bpmnElement="Gw_R3" isMarkerVisible="true">
        <dc:Bounds x="700" y="235" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Sign_R5_di" bpmnElement="Task_Sign_R5">
        <dc:Bounds x="800" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_R5_di" bpmnElement="Gw_R5" isMarkerVisible="true">
        <dc:Bounds x="950" y="235" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Sign_R1_di" bpmnElement="Task_Sign_R1">
        <dc:Bounds x="550" y="400" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_R1_di" bpmnElement="Gw_R1" isMarkerVisible="true">
        <dc:Bounds x="700" y="415" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FinalizeApproved_di" bpmnElement="Task_FinalizeApproved">
        <dc:Bounds x="1050" y="320" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Approved_di" bpmnElement="End_Approved">
        <dc:Bounds x="1210" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejected_di" bpmnElement="End_Rejected">
        <dc:Bounds x="1200" y="500" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F_Start_Task_di" bpmnElement="F_Start_Task">
        <di:waypoint x="116" y="258"/>
        <di:waypoint x="150" y="258"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Start_Init_di" bpmnElement="F_Start_Init">
        <di:waypoint x="260" y="258"/>
        <di:waypoint x="300" y="258"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Init_Gw_di" bpmnElement="F_Init_Gw">
        <di:waypoint x="400" y="258"/>
        <di:waypoint x="440" y="258"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_L1_di" bpmnElement="F_L1">
        <di:waypoint x="465" y="233"/>
        <di:waypoint x="465" y="120"/>
        <di:waypoint x="550" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_L2_di" bpmnElement="F_L2">
        <di:waypoint x="490" y="258"/>
        <di:waypoint x="550" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_L3_di" bpmnElement="F_L3">
        <di:waypoint x="465" y="283"/>
        <di:waypoint x="465" y="440"/>
        <di:waypoint x="550" y="440"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Unsupported_di" bpmnElement="F_Unsupported">
        <di:waypoint x="465" y="283"/>
        <di:waypoint x="465" y="560"/>
        <di:waypoint x="1218" y="560"/>
        <di:waypoint x="1218" y="536"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Auto_End_di" bpmnElement="F_Auto_End">
        <di:waypoint x="650" y="120"/>
        <di:waypoint x="1210" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_R3_Gw_di" bpmnElement="F_R3_Gw">
        <di:waypoint x="650" y="260"/>
        <di:waypoint x="700" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_R3_Approved_di" bpmnElement="F_R3_Approved">
        <di:waypoint x="750" y="260"/>
        <di:waypoint x="800" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_R3_Rejected_di" bpmnElement="F_R3_Rejected">
        <di:waypoint x="725" y="285"/>
        <di:waypoint x="725" y="518"/>
        <di:waypoint x="1200" y="518"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_R5_Gw_di" bpmnElement="F_R5_Gw">
        <di:waypoint x="900" y="260"/>
        <di:waypoint x="950" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_R5_Approved_di" bpmnElement="F_R5_Approved">
        <di:waypoint x="1000" y="260"/>
        <di:waypoint x="1100" y="260"/>
        <di:waypoint x="1100" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_R5_Rejected_di" bpmnElement="F_R5_Rejected">
        <di:waypoint x="975" y="285"/>
        <di:waypoint x="975" y="518"/>
        <di:waypoint x="1200" y="518"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_R1_Gw_di" bpmnElement="F_R1_Gw">
        <di:waypoint x="650" y="440"/>
        <di:waypoint x="700" y="440"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_R1_Approved_di" bpmnElement="F_R1_Approved">
        <di:waypoint x="725" y="415"/>
        <di:waypoint x="725" y="360"/>
        <di:waypoint x="1050" y="360"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_R1_Rejected_di" bpmnElement="F_R1_Rejected">
        <di:waypoint x="725" y="465"/>
        <di:waypoint x="725" y="518"/>
        <di:waypoint x="1200" y="518"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Final_End_di" bpmnElement="F_Final_End">
        <di:waypoint x="1150" y="360"/>
        <di:waypoint x="1228" y="360"/>
        <di:waypoint x="1228" y="136"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
