{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "分级审批签署",
  "type": "object",
  "properties": {
    "approved": {"type": "boolean", "title": "是否同意", "default": false},
    "remarks": {"type": "string", "title": "审批意见"},
    "signer": {"type": "string", "title": "签署人"},
    "signature": {"type": "string", "title": "电子签名"}
  },
  "required": ["approved", "signer", "signature"]
}
