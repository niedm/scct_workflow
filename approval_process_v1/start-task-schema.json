{
  "title": "填写审批参数",
  "type": "object",
  "properties": {
    "case_no": {"type": "string", "title": "Case 号"},
    "solution_id": {"type": "string", "title": "方案 ID"},
    "sign_type": {
      "type": "string",
      "title": "签署方式",
      "enum": ["AUTO", "SINGLE", "DUAL"],
      "default": "SINGLE"
    },
    "approval_level": {
      "type": "string",
      "title": "审批级别",
      "enum": ["L1", "L2", "L3", "L4", "L4-EXT"],
      "default": "L3"
    },
    "voucher_no": {"type": "string", "title": "会商凭据号"}
  },
  "required": ["case_no", "solution_id", "sign_type", "approval_level"]
}
