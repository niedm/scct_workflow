  id="Definitions_case_approval" targetNamespace="http://bpmn.io/schema/bpmn"
  exporter="Claude Code" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Case 分级审批流" processRef="Process_case_hierarchical_approval"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_case_hierarchical_approval" name="Case 分级审批流" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1"><bpmn:lane id="Lane_System" name="System"><bpmn:flowNodeRef>StartEvent_Consensus</bpmn:flowNodeRef><bpmn:flowNodeRef>ScriptTask_Init</bpmn:flowNodeRef><bpmn:flowNodeRef>BusinessRuleTask_RiskEvaluation</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_RiskRoute</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_L2Route</bpmn:flowNodeRef><bpmn:flowNodeRef>Boundary_L1</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_L1Decision</bpmn:flowNodeRef><bpmn:flowNodeRef>Boundary_L2SOP</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_L2SOPDecision</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_L2AfterR3</bpmn:flowNodeRef><bpmn:flowNodeRef>Boundary_L2Plant</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_L2PlantDecision</bpmn:flowNodeRef><bpmn:flowNodeRef>Boundary_L3Initial</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_L3InitialDecision</bpmn:flowNodeRef><bpmn:flowNodeRef>Boundary_L3Final</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_L3FinalDecision</bpmn:flowNodeRef><bpmn:flowNodeRef>Boundary_L4Initial</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_L4InitialDecision</bpmn:flowNodeRef><bpmn:flowNodeRef>Boundary_L4Final</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_L4FinalDecision</bpmn:flowNodeRef><bpmn:flowNodeRef>Boundary_L4Special</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_L4SpecialDecision</bpmn:flowNodeRef><bpmn:flowNodeRef>ScriptTask_BuildSync</bpmn:flowNodeRef><bpmn:flowNodeRef>ServiceTask_SyncApproved</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_Approved</bpmn:flowNodeRef><bpmn:flowNodeRef>ScriptTask_BuildRejection</bpmn:flowNodeRef><bpmn:flowNodeRef>ServiceTask_BroadcastRejection</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef><bpmn:flowNodeRef>ScriptTask_BuildEscalation</bpmn:flowNodeRef><bpmn:flowNodeRef>ServiceTask_SendEscalation</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_Escalated</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_R2" name="scm_r2_planner"><bpmn:flowNodeRef>UserTask_L1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_R3" name="scm_r3_sop_manager"><bpmn:flowNodeRef>UserTask_L2SOP</bpmn:flowNodeRef><bpmn:flowNodeRef>UserTask_L3Initial</bpmn:flowNodeRef><bpmn:flowNodeRef>UserTask_L4Initial</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_R5" name="scm_r5_plant_manager"><bpmn:flowNodeRef>UserTask_L2Plant</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_R1" name="scm_r1_scm_vp"><bpmn:flowNodeRef>UserTask_L3Final</bpmn:flowNodeRef><bpmn:flowNodeRef>UserTask_L4Final</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_COO" name="scm_group_coo"><bpmn:flowNodeRef>UserTask_L4Special</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Consensus" name="P10 4/4 共识"><bpmn:outgoing>Flow_Start_Init</bpmn:outgoing></bpmn:startEvent><bpmn:scriptTask id="ScriptTask_Init" name="初始化审批变量" scriptFormat="python"><bpmn:script>approval_result = "PENDING"
try:
    approval_records = approval_records
except NameError:
    approval_records = []
try:
    l2_approver_rule = l2_approver_rule
except NameError:
    l2_approver_rule = "JOINT"
try:
    notification_gateway_url = notification_gateway_url
except NameError:
    notification_gateway_url = "http://notification-gateway:8080/api/notify"
try:
    case_sync_url = case_sync_url
except NameError:
    case_sync_url = "http://case-service:8080/internal/cases/" + case_id + "/approval-events"
headers = {"Content-Type": "application/json"}
</bpmn:script><bpmn:incoming>Flow_Start_Init</bpmn:incoming><bpmn:outgoing>Flow_Init_Risk</bpmn:outgoing></bpmn:scriptTask><bpmn:businessRuleTask id="BusinessRuleTask_RiskEvaluation" name="风险判定（MoA DMN）"><bpmn:extensionElements><spiffworkflow:calledDecisionId>risk_level_decision</spiffworkflow:calledDecisionId></bpmn:extensionElements><bpmn:incoming>Flow_Init_Risk</bpmn:incoming><bpmn:outgoing>Flow_Risk_Route</bpmn:outgoing></bpmn:businessRuleTask><bpmn:exclusiveGateway id="Gateway_RiskRoute" name="按风险等级路由" default="Flow_Route_L4"><bpmn:incoming>Flow_Risk_Route</bpmn:incoming><bpmn:outgoing>Flow_Route_L1</bpmn:outgoing><bpmn:outgoing>Flow_Route_L2</bpmn:outgoing><bpmn:outgoing>Flow_Route_L3</bpmn:outgoing><bpmn:outgoing>Flow_Route_L4</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="Gateway_L2Route" name="L2 审批权属路由" default="Flow_L2_Route_Joint"><bpmn:incoming>Flow_Route_L2</bpmn:incoming><bpmn:outgoing>Flow_L2_Route_R3</bpmn:outgoing><bpmn:outgoing>Flow_L2_Route_R5</bpmn:outgoing><bpmn:outgoing>Flow_L2_Route_Joint</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="UserTask_L1" name="L1 低风险自决（R2）"><bpmn:extensionElements><spiffworkflow:instructionsForEndUser>## Case 分级审批
- 当前节点：**L1 低风险自决（R2）**
- Case：`{{case_id}}` / 方案：`{{solution_id}}` v{{solution_version}}
- 综合风险等级：**{{risk_level}}**
- 追加成本：¥{{added_cost}}
- 客户等级：{{customer_tier}} / 延期：{{delay_days}} 天
- 风险快照：`{{risk_snapshot_hash}}`
- 规则版本：{{rule_version}}

请核对风险快照后签署审批意见。</spiffworkflow:instructionsForEndUser><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="approval-decision-schema.json"/><spiffworkflow:property name="formUiSchemaFilename" value="approval-decision-uischema.json"/></spiffworkflow:properties><spiffworkflow:preScript>current_node = "L1_SELF_APPROVE"
escalation_recipients = ["scm_r2_planner"]
</spiffworkflow:preScript><spiffworkflow:postScript>approved_by = get_current_user()["username"]
try:
    _snapshot_hash = risk_snapshot_hash
except NameError:
    _snapshot_hash = None
approval_records = approval_records + [{
    "node": current_node,
    "decision": decision,
    "comment": comment,
    "approver": approved_by,
    "risk_snapshot_hash": _snapshot_hash,
}]
if decision == "REJECT":
    rejection_reason = comment
</spiffworkflow:postScript></bpmn:extensionElements><bpmn:incoming>Flow_Route_L1</bpmn:incoming><bpmn:outgoing>Flow_L1_Decision</bpmn:outgoing></bpmn:userTask><bpmn:boundaryEvent id="Boundary_L1" name="SLA 15min" attachedToRef="UserTask_L1" cancelActivity="false"><bpmn:outgoing>Flow_Esc_L1</bpmn:outgoing><bpmn:timerEventDefinition id="Boundary_L1_def"><bpmn:timeDuration>"PT15M"</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent><bpmn:exclusiveGateway id="Gateway_L1Decision" name="L1 结论" default="Flow_L1_Approve"><bpmn:incoming>Flow_L1_Decision</bpmn:incoming><bpmn:outgoing>Flow_L1_Reject</bpmn:outgoing><bpmn:outgoing>Flow_L1_Approve</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="UserTask_L2SOP" name="L2 产销审批（R3）"><bpmn:extensionElements><spiffworkflow:instructionsForEndUser>## Case 分级审批
