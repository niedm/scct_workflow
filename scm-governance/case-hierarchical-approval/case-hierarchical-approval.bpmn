ceFlow><bpmn:sequenceFlow id="Flow_L3Initial_Reject" sourceRef="Gateway_L3InitialDecision" targetRef="ScriptTask_BuildRejection" name="驳回"><bpmn:conditionExpression>decision == "REJECT"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_L3Initial_Next" sourceRef="Gateway_L3InitialDecision" targetRef="UserTask_L3Final" name="初审通过"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_L3Final_Decision" sourceRef="UserTask_L3Final" targetRef="Gateway_L3FinalDecision"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_L3Final_Reject" sourceRef="Gateway_L3FinalDecision" targetRef="ScriptTask_BuildRejection" name="驳回"><bpmn:conditionExpression>decision == "REJECT"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_L3Final_Approve" sourceRef="Gateway_L3FinalDecision" targetRef="ScriptTask_BuildSync" name="终审通过"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Esc_L3Initial" sourceRef="Boundary_L3Initial" targetRef="ScriptTask_BuildEscalation" name="超时催办"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Esc_L3Final" sourceRef="Boundary_L3Final" targetRef="ScriptTask_BuildEscalation" name="超时催办"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_L4Initial_Decision" sourceRef="UserTask_L4Initial" targetRef="Gateway_L4InitialDecision"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_L4Initial_Reject" sourceRef="Gateway_L4InitialDecision" targetRef="ScriptTask_BuildRejection" name="驳回"><bpmn:conditionExpression>decision == "REJECT"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_L4Initial_Next" sourceRef="Gateway_L4InitialDecision" targetRef="UserTask_L4Final" name="初审通过"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_L4Final_Decision" sourceRef="UserTask_L4Final" targetRef="Gateway_L4FinalDecision"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_L4Final_Reject" sourceRef="Gateway_L4FinalDecision" targetRef="ScriptTask_BuildRejection" name="驳回"><bpmn:conditionExpression>decision == "REJECT"</bpmn:conditionExpression></bp