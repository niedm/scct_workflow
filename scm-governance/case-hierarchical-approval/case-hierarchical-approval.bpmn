</spiffworkflow:postScript></bpmn:extensionElements><bpmn:incoming>Flow_L4Initial_Next</bpmn:incoming><bpmn:outgoing>Flow_L4Final_Decision</bpmn:outgoing></bpmn:userTask><bpmn:boundaryEvent id="Boundary_L4Final" name="终审 SLA 30min" attachedToRef="UserTask_L4Final" cancelActivity="false"><bpmn:outgoing>Flow_Esc_L4Final</bpmn:outgoing><bpmn:timerEventDefinition id="Boundary_L4Final_def"><bpmn:timeDuration>"PT15M"</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent><bpmn:exclusiveGateway id="Gateway_L4FinalDecision" name="L4 终审结论" default="Flow_L4Final_Next"><bpmn:incoming>Flow_L4Final_Decision</bpmn:incoming><bpmn:outgoing>Flow_L4Final_Reject</bpmn:outgoing><bpmn:outgoing>Flow_L4Final_Next</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="UserTask_L4Special" name="L4 特批（COO/经委会）"><bpmn:extensionElements><spiffworkflow:instructionsForEndUser>## Case 分级审批
- 当前节点：**L4 特批（COO/经委会）**
- Case：`{{case_id}}` / 方案：`{{solution_id}}` v{{solution_version}}
- 综合风险等级：**{{risk_level}}**
- 追加成本：¥{{added_cost}}
- 客户等级：{{customer_tier}} / 延期：{{delay_days}} 天
- 风险快照：`{{risk_snapshot_hash}}`
- 规则版本：{{rule_version}}

请核对风险快照后签署审批意见。

**L4 特批要求**：请附紧急视频会商链接、参会人，并由 COO/经委会主任联合签署。</spiffworkflow:instructionsForEndUser><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="l4-special-approval-schema.json"/><spiffworkflow:property name="formUiSchemaFilename" value="l4-special-approval-uischema.json"/></spiffworkflow:properties><spiffworkflow:preScript>current_node = "L4_SPECIAL"
escalation_recipients = ["scm_group_coo", "scm_committee_director", "scm_group_office", "scm_risk_legal"]
</spiffworkflow:preScript><spiffworkflow:postScript>approved_by = get_current_user()["username"]
try:
    _snapshot_hash = risk_snapshot_hash
except NameError:
    _snapshot_hash = None
approval_records = approval_records + [{
    "node": current_node,
    "decision": decision,
    "comment": comment,
    "approver": approved_by,
    "risk_snapshot_hash": _snapshot_hash,
}]
if decision == "REJECT":
    rejection_reason = comment
</spiffworkflow:postScript></bpmn:extensionElements><bpmn:incoming>Flow_L4Final_Next</bpmn:incoming><bpmn:outgoing>Flow_L4Special_Decision</bpmn:outgoing></bpmn:userTask><bpmn:boundaryEvent id="Boundary_L4Special" name="特批 SLA 60min" attachedToRef="UserTask_L4Special" cancelActivity="false"><bpmn:outgoing>Flow_Esc_L4Special</bpmn:outgoing><bpmn:timerEventDefinition id="Boundary_L4Special_def"><bpmn:timeDuration>"PT30M"</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent><bpmn:exclusiveGateway id="Gateway_L4SpecialDecision" name="L4 特批结论" default="Flow_L4Special_Approve"><bpmn:incoming>Flow_L4Special_Decision</bpmn:incoming><bpmn:outgoing>Flow_L4Special_Reject</bpmn:outgoing><bpmn:outgoing>Flow_L4Special_Approve</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:scriptTask id="ScriptTask_BuildSync" name="组装审批通过事件" scriptFormat="python"><bpmn:script>sync_payload = {
    "event": "approval.approved",
    "case_id": case_id,
    "solution_id": solution_id,
    "solution_version": solution_version,
    "risk_level": risk_level,
    "approval_records": approval_records,
}
approval_result = "APPROVED"
</bpmn:script><bpmn:incoming>Flow_L1_Approve</bpmn:incoming><bpmn:incoming>Flow_L2_AfterR3_Approve</bpmn:incoming><bpmn:incoming>Flow_L2Plant_Approve</bpmn:incoming><bpmn:incoming>Flow_L3Final_Approve</bpmn:incoming><bpmn:incoming>Flow_L4Special_Approve</bpmn:incoming><bpmn:outgoing>Flow_BuildSync_Service</bpmn:outgoing></bpmn:scriptTask><bpmn:serviceTask id="ServiceTask_SyncApproved" name="同步 Case 审批通过"><bpmn:extensionElements><spiffworkflow:serviceTaskOperator id="http/PostRequest" resultVariable="sync_response"><spiffworkflow:parameters><spiffworkflow:parameter id="url" type="str" value="case_sync_url"/><spiffworkflow:parameter id="headers" type="any" value="headers"/><spiffworkflow:parameter id="data" type="any" value="sync_payload"/><spiffworkflow:parameter id="basic_auth_username" type="str"/><spiffworkflow:parameter id="basic_auth_password" type="str"/></spiffworkflow:parameters></spiffworkflow:serviceTaskOperator></bpmn:extensionElements><bpmn:incoming>Flow_BuildSync_Service</bpmn:incoming><bpmn:outgoing>Flow_Sync_End</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="EndEvent_Approved" name="审批通过"><bpmn:incoming>Flow_Sync_End</bpmn:incoming></bpmn:endEvent><bpmn:scriptTask id="ScriptTask_BuildRejection" name="组装驳回事件" scriptFormat="python"><bpmn:script>try:
    _rejected_by = approved_by
except NameError:
    _rejected_by = None
try:
    _reason = rejection_reason
except NameError:
    _reason = comment
rejection_payload = {
    "event": "approval.rejected",
    "case_id": case_id,
    "solution_id": solution_id,
    "solution_version": solution_version,
    "risk_level": risk_level,
    "current_node": current_node,
    "rejected_by": _rejected_by,
    "rejection_reason": _reason,
}
approval_result = "REJECTED"
</bpmn:script><bpmn:incoming>Flow_L1_Reject</bpmn:incoming><bpmn:incoming>Flow_L2SOP_Reject</bpmn:incoming><bpmn:incoming>Flow_L2Plant_Reject</bpmn:incoming><bpmn:incoming>Flow_L3Initial_Reject</bpmn:incoming><bpmn:incoming>Flow_L3Final_Reject</bpmn:incoming><bpmn:incoming>Flow_L4Initial_Reject</bpmn:incoming><bpmn:incoming>Flow_L4Final_Reject</bpmn:incoming><bpmn:incoming>Flow_L4Special_Reject</bpmn:incoming><bpmn:outgoing>Flow_BuildRejection_Service</bpmn:outgoing></bpmn:scriptTask><bpmn:serviceTask id="ServiceTask_BroadcastRejection" name="广播驳回意见"><bpmn:extensionElements><spiffworkflow:serviceTaskOperator id="http/PostRequest" resultVariable="rejection_response"><spiffworkflow:parameters><spiffworkflow:parameter id="url" type="str" value="case_sync_url"/><spiffworkflow:parameter id="headers" type="any" value="headers"/><spiffworkflow:parameter id="data" type="any" value="rejection_payload"/><spiffworkflow:parameter id="basic_auth_username" type="str"/><spiffworkflow:parameter id="basic_auth_password" type="str"/></spiffworkflow:parameters></spiffworkflow:serviceTaskOperator></bpmn:extensionElements><bpmn:incoming>Flow_BuildRejection_Service</bpmn:incoming><bpmn:outgoing>Flow_Rejection_End</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="EndEvent_Rejected" name="退回 SOLUTION_REVISE"><bpmn:incoming>Flow_Rejection_End</bpmn:incoming></bpmn:endEvent><bpmn:scriptTask id="ScriptTask_BuildEscalation" name="组装超时催办事件" scriptFormat="python"><bpmn:script>escalation_payload = {
    "event": "approval.escalated",
    "case_id": case_id,
    "solution_id": solution_id,
    "solution_version": solution_version,
    "risk_level": risk_level,
    "current_node": current_node,
    "recipients": escalation_recipients,
    "channel": "ivr" if risk_level in ("L3", "L4") else "im",
}
</bpmn:script><bpmn:incoming>Flow_Esc_L1</bpmn:incoming><bpmn:incoming>Flow_Esc_L2SOP</bpmn:incoming><bpmn:incoming>Flow_Esc_L2Plant</bpmn:incoming><bpmn:incoming>Flow_Esc_L3Initial</bpmn:incoming><bpmn:incoming>Flow_Esc_L3Final</bpmn:incoming><bpmn:incoming>Flow_Esc_L4Initial</bpmn:incoming><bpmn:incoming>Flow_Esc_L4Final</bpmn:incoming><bpmn:incoming>Flow_Esc_L4Special</bpmn:incoming><bpmn:outgoing>Flow_BuildEscalation_Service</bpmn:outgoing></bpmn:scriptTask><bpmn:serviceTask id="ServiceTask_SendEscalation" name="发送催办/升级"><bpmn:extensionElements><spiffworkflow:serviceTaskOperator id="http/PostRequest" resultVariable="escalation_response"><spiffworkflow:parameters><spiffworkflow:parameter id="url" type="str" value="notification_gateway_url"/><spiffworkflow:parameter id="headers" type="any" value="headers"/><spiffworkflow:parameter id="data" type="any" value="escalation_payload"/><spiffworkflow:parameter id="basic_auth_username" type="str"/><spiffworkflow:parameter id="basic_auth_password" type="str"/></spiffworkflow:parameters></spiffworkflow:serviceTaskOperator></bpmn:extensionElements><bpmn:incoming>Flow_BuildEscalation_Service</bpmn:incoming><bpmn:outgoing>Flow_Escalation_End</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="EndEvent_Escalated" name="催办分支结束"><bpmn:incoming>Flow_Escalation_End</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Init" sourceRef="StartEvent_Consensus" targetRef="ScriptTask_Init"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Init_Risk" sourceRef="ScriptTask_Init" targetRef="BusinessRuleTask_RiskEvaluation"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Risk_Route" sourceRef="BusinessRuleTask_RiskEvaluation" targetRef="Gateway_RiskRoute"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Route_L1" sourceRef="Gateway_RiskRoute" targetRef="UserTask_L1" name="L1"><bpmn:conditionExpression>risk_level == "L1"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Route_L2" sourceRef="Gateway_RiskRoute" targetRef="Gateway_L2Route" name="L2"><bpmn:conditionExpression>risk_level == "L2"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Route_L3" sourceRef="Gateway_RiskRoute" targetRef="UserTask_L3Initial" name="L3"><bpmn:conditionExpression>risk_level == "L3"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Route_L4" sourceRef="Gateway_RiskRoute" targetRef="UserTask_L4Initial" name="L4 / 兜底"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_L1_Decision" sourceRef="UserTask_L1" targetRef="Gateway_L1Decision"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_L1_Reject" sourceRef="Gateway_L1Decision" targetRef="ScriptTask_BuildRejection" name="驳回"><bpmn:conditionExpression>decision == "REJECT"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_L1_Approve" sourceRef="Gateway_L1Decision" targetRef="ScriptTask_BuildSync" name="通过"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Esc_L1" sourceRef="Boundary_L1" targetRef="ScriptTask_BuildEscalation" name="超时催办"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_L2_Route_R3" sourceRef="Gateway_L2Route" targetRef="UserTask_L2SOP" name="R3 单签"><bpmn:conditionExpression>l2_approver_rule == "R3"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_L2_Route_R5" sourceRef="Gateway_L2Route" targetRef="UserTask